# ---------- Firebase (client) — Console Firebase > Impostazioni progetto > Le tue app > Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (server) — Impostazioni progetto > Account di servizio > Genera nuova chiave privata
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# Keep the \n sequences, wrap in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Server secrets
# 32 random bytes in base64: openssl rand -base64 32  (never change it once in production)
SERVER_ENC_KEY=
# Protects /api/cron (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=

# ---------- Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Secret Vault <noreply@your-verified-domain.com>"

# ---------- Optional
# Public URL used in email links (defaults to the Vercel production URL)
APP_URL=
# Twilio: if set, the access code is sent by SMS, separately from the email link
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Local development with the Firebase emulators (npm run emulators)
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# EMAIL_DEV_LOG=./emails.dev.jsonl   # without RESEND_API_KEY, emails are written here
