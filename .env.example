# ---------- Database (Supabase Postgres)
# Supabase > Connect > Transaction pooler (port 6543). The Vercel Supabase integration sets POSTGRES_URL instead.
DATABASE_URL=postgres://USER.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ---------- Server secrets
# 32 random bytes in base64: openssl rand -base64 32  (never change it once in production:
# it protects escrowed codes and recipient addresses, and peppers login passwords)
SERVER_ENC_KEY=
# Protects /api/cron (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=

# ---------- Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Secret Vault <noreply@your-verified-domain.com>"

# ---------- Optional
# Public URL used in email links (defaults to the Vercel production URL)
APP_URL=
# Twilio: if set, the access code is sent by SMS, separately from the email link
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Local development
# EMAIL_DEV_LOG=./emails.dev.jsonl   # without RESEND_API_KEY, emails are written here
